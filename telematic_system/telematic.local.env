############################################
# RSU Management Service Config
############################################
logging_level_com_telematic_telematic_rsu_management_service=INFO
rsu_server_port=8083
rsu_spring_datasource_url=jdbc:mysql://localhost:3307/rsm?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true
rsu_spring_datasource_driver=com.mysql.cj.jdbc.Driver
rsu_spring_jpa_hibernate_dialect=org.hibernate.dialect.MySQLDialect
rsu_messaging_nats_enabled=true
rsu_data_ingestion_subject_prefix=unit.*.stream.rsu.*
rsu_data_ingestion_influx_remove_fields=
rsu_data_ingestion_workers_per_unit_rsu_pair=5
rsu_data_ingestion_refresh_initial_delay_ms=30000
rsu_data_ingestion_refresh_interval_ms=30000

# RSU InfluxDB (v3, port 8181) - separate instance/product from the shared InfluxDB v2 block above.
rsu_data_ingestion_influx_url=http://localhost:8181
rsu_data_ingestion_influx_token=apiv3_YOUR_ADMIN_TOKEN_VALUE
rsu_data_ingestion_influx_database=rsu_data
rsu_influx_endpoint_configure_database=/api/v3/configure/database?format=json
rsu_influx_endpoint_query_sql=/api/v3/query_sql
rsu_influx_write_batch_size=1000
rsu_influx_write_flush_interval_ms=10
rsu_influx_write_queue_capacity=50000

# Unit Health Check Scheduler
rsu_registration_tru_autoconfig_subject=unit.*.register.rsu.autoconfig
rsu_registration_tru_config_subject=unit.*.register.rsu.config
rsu_registration_tru_config_request_timeout=5
rsu_monitor_rsu_health_subject=unit.*.monitor.rsu.health_status
rsu_monitor_rsu_health_health_timeout_seconds=10
rsu_monitor_plugin_health_subject=unit.*.monitor.plugin.health_status
rsu_monitor_plugin_health_health_timeout_seconds=10
rsu_monitor_unit_health_check_enabled=true
rsu_monitor_unit_health_check_interval_ms=60000
rsu_monitor_unit_health_check_max_missed_heartbeats=5
rsu_health_check_unit_inactivity_multiplier=5
rsu_data_selection_available_topics_subject=unit.*.topic.rsu.available_topics
rsu_data_selection_available_topics_request_timeout_seconds=10
rsu_data_selection_confirm_topics_subject=unit.*.topic.rsu.selected_topics
rsu_data_selection_confirm_topics_request_timeout_seconds=10

############################################
# Performance Metrics (optional, default: false)
# Set to true to enable checkpoint timestamp logging for latency analysis.
# Must also set PERF_METRICS_ENABLED=true in the radio unit environment.
############################################
PERF_METRICS_ENABLED=false

#Docker-Compose Configuration
DOCKER_ORG=usdotfhwastoldev
DOCKER_TAG=develop