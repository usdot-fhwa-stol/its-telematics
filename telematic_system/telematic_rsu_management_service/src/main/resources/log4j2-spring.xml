<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
  <Appenders>
    <Console name="Console" target="SYSTEM_OUT">
      <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5p [%t] %c{1.} - %m%n"/>
    </Console>
  </Appenders>

  <Loggers>
    <!-- Application package logging -->
    <Logger name="com.telematic.telematic_rsu_management_service" level="INFO" additivity="false">
      <AppenderRef ref="Console"/>
    </Logger>

    <!-- Spring framework noise reduction -->
    <Logger name="org.springframework" level="INFO"/>

    <!-- Hibernate SQL + params (enable when debugging) -->
    <!-- <Logger name="org.hibernate.SQL" level="DEBUG"/> -->
    <!-- <Logger name="org.hibernate.type.descriptor.sql" level="TRACE"/> -->

    <Root level="INFO">
      <AppenderRef ref="Console"/>
    </Root>
  </Loggers>
</Configuration>