<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
  <Appenders>
    <Console name="Console" target="SYSTEM_OUT">
      <PatternLayout withAnsi="true" pattern="%d{yyyy-MM-dd HH:mm:ss.SSS} %highlight{%-5level} [%t] %c{1.} - %m%n"/>
    </Console>
    <RollingFile name="CsvLatency" fileName="/workspace/logs/latency.csv" filePattern="/workspace/logs/latency-%d{yyyy-MM-dd}.csv.gz">
      <CsvParameterLayout delimiter="," header="buildLineLatencyMs,depositLatencyMs,overallLatencyMs,endTimeMs,threadName"/>
      <Policies>
        <TimeBasedTriggeringPolicy interval="1" modulate="true"/>
      </Policies>
    </RollingFile>
  </Appenders>

  <Loggers>
    <!-- Application package logging -->
    <Logger name="com.telematic.telematic_rsu_management_service" level="INFO" additivity="false">
      <AppenderRef ref="Console"/>
    </Logger>

    <!-- Spring framework noise reduction -->
    <Logger name="org.springframework" level="INFO"/>

    <!-- Hibernate SQL + params (enable when debugging) -->
    <!-- <Logger name="org.hibernate.SQL" level="DEBUG"/> -->
    <!-- <Logger name="org.hibernate.type.descriptor.sql" level="TRACE"/> -->

    <Root level="INFO">
      <AppenderRef ref="Console"/>
    </Root>
    <Logger name="csv" level="INFO" additivity="false">
      <AppenderRef ref="CsvLatency"/>
    </Logger>
  </Loggers>
</Configuration>