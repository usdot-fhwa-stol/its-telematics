###################################################
# MySQL Shared Connection
# Consumed by: web server, Messaging Server, Historical Processing Service (HPS),
# RSU Management Service (host/user/password only - Service uses its own database within the mysql container "rsm",
# see rsu_spring_datasource_url below).
MYSQL_HOST=localhost
MYSQL_PORT=3307 # 3306 is taken by v2xhub in CAVe-in-a-box

###################################################
# InfluxDB (v2, port 8086) Shared Connection
# Consumed by: influxdb container init, Messaging Server, HPS.
INFLUXDB_HOST=localhost
INFLUXDB_PORT=8086

###################################################
# NATS Server
# Consumed by: web server, Messaging Server, HPS, RSU Management Service.
NATS_URL=nats://localhost:4222 #change host to amazon ec2 ipv4 address for cloud deployment

###################################################
# Web server
PORT=9010
ALLOW_CLIENT_URL=http://local.cav-telematics.com:8888,http://localhost

############################################
# Performance Metrics (optional, default: false)
# Set to true to enable checkpoint timestamp logging for latency analysis.
# Must also set PERF_METRICS_ENABLED=true in the radio unit environment.
############################################
PERF_METRICS_ENABLED=false

############################################
# RSU Management Service - topology only
# Behaviour -> use_cases/rsu_integration/.env
############################################
RSU_MANAGEMENT_SERVICE_URL=http://localhost:8083 # Must match rsu_server_port
rsu_server_port=8083
rsu_spring_datasource_url=jdbc:mysql://localhost:3307/rsm?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true
# RSU InfluxDB (v3, port 8181) - separate instance/product from the shared InfluxDB v2 block above.
rsu_data_ingestion_influx_url=http://localhost:8181

############################################
# Historical Data Processing - topology only
# Behaviour -> use_cases/historical_data_processing/.env
############################################
UPLOAD_DESTINATION=host # host = local filesystem, s3 = upload to S3
UPLOAD_HTTP_PORT=9011