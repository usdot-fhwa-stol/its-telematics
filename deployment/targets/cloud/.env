# Target: cloud (managed/hosted backing services).
# Topology only - behaviour lives in use_cases/<use case>/.env.
#
# A derived value is frozen when it is defined; Compose does not re-evaluate it
# if a later layer changes an input. Any host/port overridden here must have its
# URLs redefined here too.
#
# Every host below is a placeholder - set them before deploying.

# 3306 suits an external instance (e.g. RDS). The bundled mysqldb in
# docker-compose.dbs.yml publishes 3307 instead.
MYSQL_HOST=localhost
MYSQL_PORT=3306

# Host only - no scheme, no port. Empty yields a malformed "http://:8086".
INFLUXDB_HOST=localhost
INFLUXDB_PORT=8086

# InfluxDB v3, used by the rsu_integration use case only.
INFLUXDB3_IP=127.0.0.1

# NATS_IP/NATS_PORT also drive the wait-for-it gates in docker-compose.core.yml
# and docker-compose.rsu.yml - keep them in step with NATS_URL.
NATS_IP=127.0.0.1
NATS_PORT=4222
NATS_URL=nats://${NATS_IP}:${NATS_PORT}

PORT=9010
ALLOW_CLIENT_URL=http://local.cav-telematics.com:8888,http://localhost

# Requires PERF_METRICS_ENABLED=true in the radio unit environment as well.
PERF_METRICS_ENABLED=false

rsu_server_port=8083
RSU_MANAGEMENT_SERVICE_URL=http://localhost:${rsu_server_port}
rsu_spring_datasource_url=jdbc:mysql://${MYSQL_HOST}:${MYSQL_PORT}/rsm?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true
rsu_data_ingestion_influx_url=http://${INFLUXDB3_IP}:8181

UPLOAD_DESTINATION=host # host or s3
UPLOAD_HTTP_PORT=9011

APACHE2_DOCKERFILE=./Dockerfile
APACHE2_IMAGE=telematic_apache2

# Read only when UPLOAD_DESTINATION=s3.
AWS_ACCESS_KEY_ID=
AWS_SECRET_KEY=
S3_BUCKET=
S3_REGION=us-east-2
