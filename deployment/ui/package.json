{
  "name": "telematics-deploy",
  "productName": "Telematics Deploy",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop UI that collects deployment inputs and runs deployment/scripts/setup.py",
  "main": "electron/main.js",
  "scripts": {
    "dev": "node scripts/run-app.mjs",
    "build": "vite build",
    "start": "vite build && node scripts/run-app.mjs --built",
    "test": "node --test \"test/**/*.test.js\""
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^5.18.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^44.9.0",
    "vite": "^5.4.21"
  }
}
