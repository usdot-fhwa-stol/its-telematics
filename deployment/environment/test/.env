# LAYER: ENVIRONMENT (tier = test)
# Credentials, secrets, bucket/org names, log verbosity - anything that differs
# between dev/test/prod on the same target. Loaded last, so it wins over the
# target and use-case layers.
# Hosts/ports -> targets/<target>/.env
# TODO: still the dev credentials - replace before any real test deployment.

###################################################
# MySQL Shared Connection
# Consumed by: web server, Messaging Server, Historical Processing Service (HPS),
# NOTE: mysqldb itself reads its passwords from telematic_system/secrets/, not
# from MYSQL_PASSWORD. Keep the two in sync.
MYSQL_USER=telematic
MYSQL_PASSWORD=telematic
MYSQL_DATABASE=wfd_grafana

###################################################
# InfluxDB (v2, port 8086) Shared Connection
# Consumed by: influxdb container init, Messaging Server, HPS.
# NOTE: DOCKER_INFLUXDB_INIT_* names below are fixed by the official influxdb Docker
# image itself (docker-compose.local.yml passes this whole file straight into the
# container via env_file, with no renaming layer) - do not rename these.
# They only apply on first boot of an empty /opt/influxdb2 volume.
DOCKER_INFLUXDB_INIT_CLI_CONFIG_NAME=telematic
DOCKER_INFLUXDB_INIT_MODE=setup
DOCKER_INFLUXDB_INIT_USERNAME=admin #Required: Create a credential username on container initial startup.
DOCKER_INFLUXDB_INIT_PASSWORD=P@ssword1 #Required: Create a credential password on container initial startup.
DOCKER_INFLUXDB_INIT_ORG=my-org #Required: Create an organization on container startup. You can create more orgs inside the same influxDB container.
DOCKER_INFLUXDB_INIT_BUCKET=infrastructure-dev #Required: Create a bucket on container initial startup. Must match MESSAGING_INFLUX_BUCKET_* in use_cases/core/.env.
DOCKER_INFLUXDB_INIT_RETENTION=0
DOCKER_INFLUXDB_INIT_ADMIN_TOKEN=my-super-secret-auth-token #Required: Manually set the token value

# Bucket HPS writes decoded rosbag/mcap data to.
HPS_INFLUX_BUCKET=infrastructure-dev

###################################################
# Web server
## Security
GRAFANA_HTPASSWORD=/opt/apache2/grafana_htpasswd # Path inside the container, shared with apache2
SESSION_TIMEOUT=3600 # Seconds
SECRET=my_secret_telematic_ui # Session cookie signing key

############################################
# Performance Metrics (optional, default: false)
# Set to true to enable checkpoint timestamp logging for latency analysis.
# Must also set PERF_METRICS_ENABLED=true in the radio unit environment.
############################################
PERF_METRICS_ENABLED=false
